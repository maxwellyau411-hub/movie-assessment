# Local Compose configuration. Copy to .env:  cp .env.example .env
# These values are local-only placeholders for a throwaway database on your machine.
# Do not reuse them anywhere else; .env is git-ignored.

POSTGRES_PASSWORD=local-only-postgres-admin
MEDIA_DB_PASSWORD=local-only-media-service-db
CATALOGUE_DB_PASSWORD=local-only-catalogue-service-db

# Browser entry point: http://127.0.0.1:${WEB_PORT}
WEB_PORT=8088

# Local switches (defaults in compose.yaml are true): demo data on first start, GraphiQL at /graphiql.
# CATALOGUE_DEMO_DATA=true
# CATALOGUE_GRAPHIQL=true

# Optional large catalogue (docker compose run --rm large-seed). Defaults shown.
# LARGE_SEED_MOVIES=20000
# LARGE_SEED_PEOPLE=10000
# LARGE_SEED_CREDITS=100000

# Optional: absolute path to a PEM CA certificate, only if your network intercepts HTTPS and
# image builds fail with "PKIX path building failed" / "unable to get local issuer certificate".
# EXTRA_CA_CERT_FILE=/absolute/path/to/inspection-ca.pem
